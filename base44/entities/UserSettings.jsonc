{
  "name": "UserSettings",
  "type": "object",
  "properties": {
    "daily_loss_limit": {
      "type": "number"
    },
    "risk_per_trade": {
      "type": "number"
    },
    "account_size": {
      "type": "number"
    },
    "default_instrument": {
      "type": "string",
      "enum": [
        "NQ",
        "ES",
        "MNQ"
      ],
      "default": "NQ"
    },
    "daily_trade_limit": {
      "type": "number"
    },
    "active_sessions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "timezone": {
      "type": "string",
      "default": "America/New_York"
    },
    "theme": {
      "type": "string",
      "enum": [
        "dark",
        "light"
      ],
      "default": "dark"
    }
  },
  "required": []
}